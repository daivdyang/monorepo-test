# 這些是 runtime 環境變數（Nuxt 以 NUXT_ 前綴對應 runtimeConfig）。
# 本機開發：複製到 apps/web/.env 或 apps/admin/.env（Nuxt 讀取各 app 目錄下的 .env）。

# 後台登入密碼（apps/admin）
NUXT_ADMIN_PASSWORD=admin123

# SQLite 檔案路徑（web 與 admin 必須指向同一個檔案）；部署時務必設定
NUXT_DB_PATH=/absolute/path/to/.data/mono.db

# 前台網站名稱（apps/web）
NUXT_PUBLIC_SITE_NAME=Mono Shop
