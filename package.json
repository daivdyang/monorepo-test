{
  "name": "mono-test",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@mono/web",
    "dev:admin": "turbo run dev --filter=@mono/admin",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@mono/web...",
    "build:admin": "turbo run build --filter=@mono/admin...",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "boundaries": "turbo boundaries",
    "check": "turbo boundaries && turbo run lint typecheck test",
    "test": "turbo run test",
    "check:affected": "turbo boundaries && turbo run lint typecheck test build --affected",
    "clean:modules": "node scripts/clean-modules.mjs"
  },
  "devDependencies": {
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
