{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "prepare:nuxt": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "^prepare:nuxt"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "NUXT_*"
      ],
      "outputs": [
        ".output/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "transit"
      ]
    },
    "lint": {
      "dependsOn": [
        "transit"
      ]
    },
    "test": {
      "dependsOn": [
        "transit"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "boundaries": {
    "tags": {
      "app": {
        "dependents": {
          "allow": []
        }
      },
      "core": {
        "dependencies": {
          "allow": [
            "config"
          ]
        }
      },
      "ui": {
        "dependencies": {
          "allow": [
            "core",
            "config"
          ]
        }
      },
      "server-only": {
        "dependencies": {
          "allow": [
            "core",
            "config"
          ]
        }
      }
    }
  }
}
